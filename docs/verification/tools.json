{
 "tools": [
  {
   "name": "search_performances",
   "kind": "external",
   "description": "사용자가 볼 공연을 아직 정하지 않았을 때, 날짜·지역·장르 조건으로 실제 공연 중인 후보 목록을 찾을 때 사용한다. 결과의 performance_id 를 get_performance_detail 에 넘긴다.",
   "input_schema": {
    "additionalProperties": false,
    "properties": {
     "date": {
      "anyOf": [
       {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "관람 날짜 YYYY-MM-DD. 생략하면 오늘",
      "title": "Date"
     },
     "region": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "지역 이름. 예: 대학로, 종로구, 강남, 홍대, 서울",
      "title": "Region"
     },
     "genre": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "장르 이름. 예: 연극, 뮤지컬, 클래식, 국악, 대중음악, 무용",
      "title": "Genre"
     },
     "keyword": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "공연명 일부. 특정 공연을 찾을 때만 사용",
      "title": "Keyword"
     },
     "limit": {
      "default": 20,
      "description": "가져올 후보 수 (최대 50)",
      "maximum": 50,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
     }
    },
    "title": "SearchInput",
    "type": "object"
   }
  },
  {
   "name": "get_performance_detail",
   "kind": "external",
   "description": "후보 공연의 러닝타임·요일별 회차 시각·가격·관람 연령을 확인해 시간과 예산 조건을 판단해야 할 때 사용한다. performance_id 는 search_performances 결과에서 얻는다.",
   "input_schema": {
    "additionalProperties": false,
    "properties": {
     "performance_id": {
      "description": "search_performances 결과의 performance_id (예: PF306989)",
      "pattern": "^PF\\w+$",
      "title": "Performance Id",
      "type": "string"
     }
    },
    "required": [
     "performance_id"
    ],
    "title": "DetailInput",
    "type": "object"
   }
  },
  {
   "name": "search_nearby_places",
   "kind": "external",
   "description": "추천할 공연장 주변의 식당·카페·주차장을 함께 안내해야 할 때 사용한다. get_performance_detail 결과의 venue_id 를 넣거나 좌표를 넣는다.",
   "input_schema": {
    "additionalProperties": false,
    "properties": {
     "venue_id": {
      "anyOf": [
       {
        "pattern": "^FC\\w+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "get_performance_detail 결과의 venue_id (예: FC001091)",
      "title": "Venue Id"
     },
     "x": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "경도. venue_id 가 없을 때 사용",
      "title": "X"
     },
     "y": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "위도. venue_id 가 없을 때 사용",
      "title": "Y"
     },
     "category": {
      "default": "restaurant",
      "description": "찾을 장소 종류",
      "enum": [
       "restaurant",
       "cafe",
       "parking"
      ],
      "title": "Category",
      "type": "string"
     },
     "radius_m": {
      "default": 500,
      "description": "검색 반경(미터)",
      "maximum": 2000,
      "minimum": 1,
      "title": "Radius M",
      "type": "integer"
     },
     "size": {
      "default": 5,
      "description": "가져올 장소 수",
      "maximum": 15,
      "minimum": 1,
      "title": "Size",
      "type": "integer"
     }
    },
    "title": "NearbyInput",
    "type": "object"
   }
  }
 ]
}