# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git에 올라가지 않는다. (NF3001)
# ⚠ 이 파일(.env.example)에는 실제 키를 넣지 않는다 — git에 커밋되는 템플릿이다.

# --- LLM (OpenAI 호환) ---
# 개인 OpenAI 키: LLM_BASE_URL 을 비워 둔다
# SSAFY GMS 키:  LLM_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini

# --- 외부 API ---
# KOPIS 공연예술통합전산망 서비스 키 (kopis.or.kr → Open API)
KOPIS_API_KEY=
# 카카오 REST API 키 (developers.kakao.com → 내 애플리케이션 → 앱 키)
KAKAO_REST_API_KEY=
