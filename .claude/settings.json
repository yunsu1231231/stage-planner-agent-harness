{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/harness_gate.py\" pretool",
            "timeout": 600,
            "statusMessage": "harness gate: commit/push 전 pytest"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/harness_gate.py\" stop",
            "timeout": 600,
            "statusMessage": "harness gate: 종료 전 pytest"
          }
        ]
      }
    ]
  }
}
